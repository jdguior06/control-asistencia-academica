          },
          "refId": "A",
          "expr": "max by (tenant) (httpcheck_duration_milliseconds{rol=\"backend\", http_url=~\".*/api/health\", tenant!=\"plataforma\", entorno=~\"$entorno\"})",
          "legendFormat": "{{tenant}}",
