          },
          "expr": "sum by (tenant) (increase(nginx_api_errores_total{tenant!=\"plataforma\", entorno=~\"$entorno\"}[1m]))",
          "legendFormat": "{{tenant}}"
        }
      ],
      "options": {
        "legend": {
