    {
      "id": 16,
      "type": "timeseries",
      "title": "Errores del backend (5xx por minuto)",
      "description": "Respuestas 5xx de /api por tenant (Nginx del frontend).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
