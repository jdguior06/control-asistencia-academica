{
  "uid": "tenant-detalle",
  "title": "Tenant - Detalle",
  "description": "Los 3 servidores de un tenant: API, base de datos, Nginx, sistema y procesos.",
  "tags": [
    "asistencia",
    "multitenant"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "entorno",
        "label": "Entorno",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{tenant!=\"plataforma\"}, entorno)",
          "refId": "entorno"
        },
        "definition": "label_values(up{tenant!=\"plataforma\"}, entorno)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{tenant!=\"plataforma\", entorno=~\"$entorno\"}, tenant)",
          "refId": "tenant"
        },
        "definition": "label_values(up{tenant!=\"plataforma\", entorno=~\"$entorno\"}, tenant)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "servidor",
        "label": "Servidor",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{tenant=\"$tenant\"}, servidor)",
          "refId": "servidor"
        },
        "definition": "label_values(up{tenant=\"$tenant\"}, servidor)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Resumen del tenant $tenant",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API (/api/health)",
      "description": "Frontend: pasa por Nginx. Backend: directo. Ambos prueban PostgreSQL.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (servidor) (httpcheck_status{http_status_class=\"2xx\", http_url=~\".*/api/health\", tenant=\"$tenant\"})",
          "legendFormat": "{{servidor}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "SIN RESPUESTA",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "links": []
        },
        "overrides": []
      }
    },
