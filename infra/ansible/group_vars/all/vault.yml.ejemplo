# Secretos de la PLATAFORMA. Copia este archivo a vault.yml, cambia los valores y cífralo:
#   cp group_vars/all/vault.yml.ejemplo group_vars/all/vault.yml
#   nano group_vars/all/vault.yml
#   ansible-vault encrypt group_vars/all/vault.yml
#
# Solo letras y números, 12 caracteres o más.
# Los secretos de cada tenant NO van aquí: se generan solos (ver vars.yml).

vault_portal_admin_password: CambiarEstaClave1    # entrar al portal como operador@example.com
vault_portal_db_password: CambiarEstaClave2       # base de datos del portal
vault_grafana_password: CambiarEstaClave3         # usuario admin de Grafana

# Worker del portal (crea los tenants):
vault_pulumi_passphrase: CambiarEstaFrase4         # cifra la configuración de cada stack de Pulumi
vault_infracost_api_key: ""                        # opcional: clave gratuita de infracost.io (costo estimado)

# Alertas por correo (opcional). Sin SMTP, las alertas igual se ven en el portal.
vault_alertas_correos: ""                          # tu correo (varios: separados por coma)
vault_alertas_admin_tenant: true                   # avisar también al administrador del tenant
vault_smtp_user: ""                                # cuenta de Gmail que envía
vault_smtp_password: ""                            # contraseña de aplicación de Gmail (16 letras, sin espacios)
# vault_smtp_host: smtp.gmail.com
# vault_smtp_port: 587
